# ==============================================================================
# Spun (TextileERP) - Environment Configuration
# Copy this file to `.env` and fill in your values for local or production use.
# ==============================================================================

# Application URL (Canonical base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection URL
# For local Postgres: postgres://<user>:<password>@<host>:<port>/<database>
# For Docker Compose: postgres://postgres:postgres@db:5432/spun
DATABASE_URL="postgres://postgres:postgres@localhost:5432/spun"

# NextAuth.js Secret
# Generate a secure 32-byte secret using: `openssl rand -base64 32`
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------

# Google OAuth (Optional: Leave blank to disable Google Sign-In)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Indian GSTIN Lookup API (Optional: via https://sheet.gstincheck.co.in)
# If provided, auto-populates party details from GST number during creation
# GSTINCHECK_API_KEY=""
